# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://localhost:5173

# MySQL 8
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=adpilot
DATABASE_USER=adpilot
DATABASE_PASSWORD=change_me
DATABASE_LOGGING=false

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (required values are enforced in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Meta (Phase 3)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/v1/integrations/meta/oauth/callback
META_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_DIALOG_BASE_URL=https://www.facebook.com
META_OAUTH_SCOPES=ads_management,business_management,pages_show_list,pages_read_engagement,instagram_basic,leads_retrieval

# Integration credential encryption (required in production, base64 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# WhatsApp (Phase 8)
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Object storage (Phase 5)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# AI (Phase 11)
AI_PROVIDER=
AI_API_KEY=
